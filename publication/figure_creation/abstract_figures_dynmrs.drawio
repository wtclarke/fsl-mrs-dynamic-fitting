  <diagram name="configuration-fmrs" id="aiONP0IDkCKHRzw4kF_Q">
    <mxGraphModel dx="954" dy="589" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" background="none" math="0" shadow="0">
      <root>
        <mxCell id="cXpkuweFrOjD9feFtG9y-0" />
        <mxCell id="cXpkuweFrOjD9feFtG9y-1" parent="cXpkuweFrOjD9feFtG9y-0" />
        <mxCell id="cXpkuweFrOjD9feFtG9y-5" value="&lt;div style=&quot;font-family: menlo, monaco, &amp;quot;courier new&amp;quot;, monospace; font-size: 12px; line-height: 18px;&quot;&gt;&lt;div style=&quot;color: rgb(212, 212, 212);&quot;&gt;&lt;div style=&quot;color: rgb(0, 0, 0); background-color: rgb(255, 255, 255); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; line-height: 18px;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;line-height: 18px;&quot;&gt;&lt;div&gt;&lt;b&gt;from numpy &lt;span style=&quot;color: #0000ff;&quot;&gt;import&lt;/span&gt; dot&lt;/b&gt;&lt;/div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;b&gt;Parameters = {&lt;/b&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;    &lt;span style=&quot;color: #a31515;&quot;&gt;&#39;conc&#39;&lt;/span&gt;     : {&lt;span style=&quot;color: #a31515;&quot;&gt;&#39;dynamic&#39;&lt;/span&gt;: &lt;span style=&quot;color: #a31515;&quot;&gt;&#39;model_glm&#39;&lt;/span&gt;, &lt;span style=&quot;color: #a31515;&quot;&gt;&#39;params&#39;&lt;/span&gt;: [&lt;span style=&quot;color: #a31515;&quot;&gt;&#39;beta_STIM0&#39;&lt;/span&gt;, &lt;span style=&quot;color: #a31515;&quot;&gt;&#39;beta_STIM1&#39;&lt;/span&gt;, &lt;span style=&quot;color: #a31515;&quot;&gt;&#39;beta_LIN&#39;&lt;/span&gt;, &lt;span style=&quot;color: #a31515;&quot;&gt;&#39;beta_CONST&#39;&lt;/span&gt;]},&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;    &lt;span style=&quot;color: #a31515;&quot;&gt;&#39;gamma&#39;&lt;/span&gt;    : &lt;span style=&quot;color: #a31515;&quot;&gt;&#39;fixed&#39;&lt;/span&gt;,&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;    &lt;span style=&quot;color: #a31515;&quot;&gt;&#39;sigma&#39;&lt;/span&gt;    : {&lt;span style=&quot;color: #a31515;&quot;&gt;&#39;dynamic&#39;&lt;/span&gt;: &lt;span style=&quot;color: #a31515;&quot;&gt;&#39;model_glm&#39;&lt;/span&gt;, &lt;span style=&quot;color: #a31515;&quot;&gt;&#39;params&#39;&lt;/span&gt;: [&lt;span style=&quot;color: #a31515;&quot;&gt;&#39;beta_STIM0&#39;&lt;/span&gt;, &lt;span style=&quot;color: #a31515;&quot;&gt;&#39;beta_STIM1&#39;&lt;/span&gt;, &lt;span style=&quot;color: #a31515;&quot;&gt;&#39;beta_LIN&#39;&lt;/span&gt;, &lt;span style=&quot;color: #a31515;&quot;&gt;&#39;beta_CONST&#39;&lt;/span&gt;]},&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;    &lt;span style=&quot;color: #a31515;&quot;&gt;&#39;eps&#39;&lt;/span&gt;      : &lt;span style=&quot;color: #a31515;&quot;&gt;&#39;fixed&#39;&lt;/span&gt;,&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;    &lt;span style=&quot;color: #a31515;&quot;&gt;&#39;baseline&#39;&lt;/span&gt; : &lt;span style=&quot;color: #a31515;&quot;&gt;&#39;fixed&#39;&lt;/span&gt;,&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;    &lt;span style=&quot;color: #a31515;&quot;&gt;&#39;Phi_0&#39;&lt;/span&gt;    : &lt;span style=&quot;color: #a31515;&quot;&gt;&#39;fixed&#39;&lt;/span&gt;,&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;    &lt;span style=&quot;color: #a31515;&quot;&gt;&#39;Phi_1&#39;&lt;/span&gt;    : &lt;span style=&quot;color: #a31515;&quot;&gt;&#39;fixed&#39;&lt;/span&gt;}&lt;/b&gt;&lt;/div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Bounds = {&lt;/b&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;    &lt;span style=&quot;color: #a31515;&quot;&gt;&#39;gamma&#39;&lt;/span&gt;: (&lt;span style=&quot;color: #098658;&quot;&gt;0&lt;/span&gt;, &lt;span style=&quot;color: #0000ff;&quot;&gt;None&lt;/span&gt;),&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;    &lt;span style=&quot;color: #a31515;&quot;&gt;&#39;beta_CONST&#39;&lt;/span&gt;: (&lt;span style=&quot;color: #098658;&quot;&gt;0&lt;/span&gt;, &lt;span style=&quot;color: #0000ff;&quot;&gt;None&lt;/span&gt;)}&lt;/b&gt;&lt;/div&gt;&lt;b&gt;&lt;div style=&quot;line-height: 18px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;color: #008000;&quot;&gt;&lt;b&gt;# Dynamic models&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;span style=&quot;color: #0000ff;&quot;&gt;def&lt;/span&gt; model_glm(p, t):&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;    &lt;span style=&quot;color: #0000ff;&quot;&gt;return&lt;/span&gt; dot(t, p)&lt;/b&gt;&lt;/div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;color: #008000;&quot;&gt;&lt;b&gt;# Dynamic model gradients&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;span style=&quot;color: #0000ff;&quot;&gt;def&lt;/span&gt; model_glm_grad(p, t):&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;    &lt;span style=&quot;color: #0000ff;&quot;&gt;return&lt;/span&gt; t.T&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;fontSize=54;fontColor=#E1812D;" parent="cXpkuweFrOjD9feFtG9y-1" vertex="1">
          <mxGeometry x="20" y="425" width="788" height="438" as="geometry" />
        </mxCell>
        <mxCell id="cXpkuweFrOjD9feFtG9y-7" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=54;fontColor=#E1812D;strokeWidth=4;align=left;verticalAlign=bottom;fillColor=none;" parent="cXpkuweFrOjD9feFtG9y-1" vertex="1">
          <mxGeometry x="11.88" y="379" width="816" height="492" as="geometry" />
        </mxCell>
        <mxCell id="cXpkuweFrOjD9feFtG9y-8" value="B. fMRS" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=38;" parent="cXpkuweFrOjD9feFtG9y-1" vertex="1">
          <mxGeometry x="11.88" y="394" width="157.12" height="23" as="geometry" />
        </mxCell>
        <mxCell id="cXpkuweFrOjD9feFtG9y-12" value="GLM used to model concentrations and Gaussian line-broadening (sigma). &lt;br&gt;All other parameters are fixed to a single value." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=25;fontStyle=2" parent="cXpkuweFrOjD9feFtG9y-1" vertex="1">
          <mxGeometry x="203" y="548" width="587" height="105" as="geometry" />
        </mxCell>
        <mxCell id="cXpkuweFrOjD9feFtG9y-13" value="Model is dot-product of GLM design matrix and time variable." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=25;fontStyle=2" parent="cXpkuweFrOjD9feFtG9y-1" vertex="1">
          <mxGeometry x="203" y="736" width="573" height="74" as="geometry" />
        </mxCell>
        <mxCell id="cXpkuweFrOjD9feFtG9y-14" value="Gradient is therefore the time variable." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=25;fontStyle=2" parent="cXpkuweFrOjD9feFtG9y-1" vertex="1">
          <mxGeometry x="206" y="810" width="573" height="45" as="geometry" />
        </mxCell>
        <mxCell id="TZdyzqBvZoKejzI1XsLm-0" value="Lorentzian (gamma) line-broadening and GLM constant term must be positive." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=25;fontStyle=2" parent="cXpkuweFrOjD9feFtG9y-1" vertex="1">
          <mxGeometry x="206" y="656" width="573" height="74" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="configuration-dwmrs" id="a05XVuW5XhzSWjCj0Kry">
    <mxGraphModel dx="954" dy="589" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" background="none" math="0" shadow="0">
      <root>
        <mxCell id="7Us3IM6Tyc1Voor4KtUj-0" />
        <mxCell id="7Us3IM6Tyc1Voor4KtUj-1" parent="7Us3IM6Tyc1Voor4KtUj-0" />
        <mxCell id="7Us3IM6Tyc1Voor4KtUj-3" value="&lt;div style=&quot;font-family: menlo, monaco, &amp;quot;courier new&amp;quot;, monospace; font-size: 12px; line-height: 18px;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;background-color: rgb(255, 255, 255); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; line-height: 18px;&quot;&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;Parameters = {&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font color=&quot;#a31515&quot;&gt;   &#39;conc&#39;&lt;/font&gt;&lt;font color=&quot;#000000&quot;&gt;     : {&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;        &lt;span style=&quot;color: #a31515;&quot;&gt;&amp;nbsp; &amp;nbsp;&#39;MM&#39;&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;: {&lt;span style=&quot;color: #a31515;&quot;&gt;&#39;dynamic&#39;&lt;/span&gt;: &lt;span style=&quot;color: #a31515;&quot;&gt;&#39;model_exp&#39;&lt;/span&gt;,&amp;nbsp; &amp;nbsp;&lt;span style=&quot;color: #a31515;&quot;&gt;&#39;params&#39;&lt;/span&gt;: [&lt;span style=&quot;color: #a31515;&quot;&gt;&#39;c_amp&#39;&lt;/span&gt;, &lt;span style=&quot;color: #a31515;&quot;&gt;&#39;c_mono_adc&#39;&lt;/span&gt;]},&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;        &lt;span style=&quot;color: #a31515;&quot;&gt;&amp;nbsp; &amp;nbsp;&#39;other&#39;&lt;/span&gt; : {&lt;span style=&quot;color: #a31515;&quot;&gt;&#39;dynamic&#39;&lt;/span&gt;: &lt;span style=&quot;color: #a31515;&quot;&gt;&#39;model_biexp&#39;&lt;/span&gt;, &lt;span style=&quot;color: #a31515;&quot;&gt;&#39;params&#39;&lt;/span&gt;: [&lt;span style=&quot;color: #a31515;&quot;&gt;&#39;c_amp&#39;&lt;/span&gt;, &lt;span style=&quot;color: #a31515;&quot;&gt;&#39;c_adc_slow&#39;&lt;/span&gt;, &lt;span style=&quot;color: #a31515;&quot;&gt;&#39;c_adc_fast&#39;&lt;/span&gt;, &lt;span style=&quot;color: #a31515;&quot;&gt;&#39;c_frac_slow&#39;&lt;/span&gt;]}&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp; &amp;nbsp;},&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;   &lt;span style=&quot;color: #a31515;&quot;&gt;&#39;baseline&#39;&lt;/span&gt; : {&lt;span style=&quot;color: #a31515;&quot;&gt;&#39;dynamic&#39;&lt;/span&gt;: &lt;span style=&quot;color: #a31515;&quot;&gt;&#39;model_exp_offset&#39;&lt;/span&gt;, &lt;span style=&quot;color: #a31515;&quot;&gt;&#39;params&#39;&lt;/span&gt;: [&lt;span style=&quot;color: #a31515;&quot;&gt;&#39;b_amp&#39;&lt;/span&gt;, &lt;span style=&quot;color: #a31515;&quot;&gt;&#39;b_adc&#39;&lt;/span&gt;, &lt;span style=&quot;color: #a31515;&quot;&gt;&#39;b_off&#39;&lt;/span&gt;]}&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;}&lt;/div&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;Bounds = {&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;    &lt;span style=&quot;color: #a31515;&quot;&gt;&#39;c_amp&#39;&lt;/span&gt;       : (&lt;span style=&quot;color: #098658;&quot;&gt;0&lt;/span&gt;, &lt;span style=&quot;color: #0000ff;&quot;&gt;None&lt;/span&gt;),&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;    &lt;span style=&quot;color: #a31515;&quot;&gt;&#39;c_mono_adc&#39;&lt;/span&gt;  : (&lt;span style=&quot;color: #098658;&quot;&gt;0&lt;/span&gt;, &lt;span style=&quot;color: #0000ff;&quot;&gt;None&lt;/span&gt;),&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;    &lt;span style=&quot;color: #a31515;&quot;&gt;&#39;c_adc_slow&#39;&lt;/span&gt;  : (&lt;span style=&quot;color: #098658;&quot;&gt;0&lt;/span&gt;, &lt;span style=&quot;color: #098658;&quot;&gt;.1&lt;/span&gt;),&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;    &lt;span style=&quot;color: #a31515;&quot;&gt;&#39;c_adc_fast&#39;&lt;/span&gt;  : (&lt;span style=&quot;color: #098658;&quot;&gt;.1&lt;/span&gt;, &lt;span style=&quot;color: #098658;&quot;&gt;4&lt;/span&gt;),&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;    &lt;span style=&quot;color: #a31515;&quot;&gt;&#39;c_frac_slow&#39;&lt;/span&gt; : (&lt;span style=&quot;color: #098658;&quot;&gt;0&lt;/span&gt;, &lt;span style=&quot;color: #098658;&quot;&gt;1&lt;/span&gt;),&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;    &lt;span style=&quot;color: #a31515;&quot;&gt;&#39;gamma&#39;&lt;/span&gt;       : (&lt;span style=&quot;color: #098658;&quot;&gt;0&lt;/span&gt;, &lt;span style=&quot;color: #0000ff;&quot;&gt;None&lt;/span&gt;),&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;    &lt;span style=&quot;color: #a31515;&quot;&gt;&#39;sigma&#39;&lt;/span&gt;       : (&lt;span style=&quot;color: #098658;&quot;&gt;0&lt;/span&gt;, &lt;span style=&quot;color: #0000ff;&quot;&gt;None&lt;/span&gt;),&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;    &lt;span style=&quot;color: #a31515;&quot;&gt;&#39;b_amp&#39;&lt;/span&gt;       : (&lt;span style=&quot;color: #0000ff;&quot;&gt;None&lt;/span&gt;, &lt;span style=&quot;color: #0000ff;&quot;&gt;None&lt;/span&gt;),&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;    &lt;span style=&quot;color: #a31515;&quot;&gt;&#39;b_adc&#39;&lt;/span&gt;       : (&lt;span style=&quot;color: #098658;&quot;&gt;1E-5&lt;/span&gt;, &lt;span style=&quot;color: #098658;&quot;&gt;3&lt;/span&gt;),&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;}&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;color: #008000;&quot;&gt;# Dynamic models&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;color: #0000ff;&quot;&gt;from&lt;/span&gt; numpy &lt;span style=&quot;color: #0000ff;&quot;&gt;import&lt;/span&gt; exp&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;color: #0000ff;&quot;&gt;from&lt;/span&gt; numpy &lt;span style=&quot;color: #0000ff;&quot;&gt;import&lt;/span&gt; asarray&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;color: #0000ff;&quot;&gt;from&lt;/span&gt; numpy &lt;span style=&quot;color: #0000ff;&quot;&gt;import&lt;/span&gt; ones_like&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;color: #008000;&quot;&gt;# Mono-exponential&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;color: #0000ff;&quot;&gt;def&lt;/span&gt; model_exp(p, t):&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;    &lt;span style=&quot;color: #008000;&quot;&gt;# p = [amp,adc]&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;    &lt;span style=&quot;color: #0000ff;&quot;&gt;return&lt;/span&gt; p[&lt;span style=&quot;color: #098658;&quot;&gt;0&lt;/span&gt;]*exp(-p[&lt;span style=&quot;color: #098658;&quot;&gt;1&lt;/span&gt;]*t)&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;color: #008000;&quot;&gt;# Mono-exponential model with offset&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;color: #0000ff;&quot;&gt;def&lt;/span&gt; model_exp_offset(p, t):&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;    &lt;span style=&quot;color: #008000;&quot;&gt;# p = [amp,adc,off]&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;    &lt;span style=&quot;color: #0000ff;&quot;&gt;return&lt;/span&gt; p[&lt;span style=&quot;color: #098658;&quot;&gt;2&lt;/span&gt;]+p[&lt;span style=&quot;color: #098658;&quot;&gt;0&lt;/span&gt;]*exp(-p[&lt;span style=&quot;color: #098658;&quot;&gt;1&lt;/span&gt;]*t)&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;color: #008000;&quot;&gt;# Bi-exponential model&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;color: #0000ff;&quot;&gt;def&lt;/span&gt; model_biexp(p, t):&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;    &lt;span style=&quot;color: #008000;&quot;&gt;# p = [amp,adc1,adc2,frac]&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;    &lt;span style=&quot;color: #0000ff;&quot;&gt;return&lt;/span&gt; p[&lt;span style=&quot;color: #098658;&quot;&gt;0&lt;/span&gt;]*(p[&lt;span style=&quot;color: #098658;&quot;&gt;3&lt;/span&gt;]*exp(-p[&lt;span style=&quot;color: #098658;&quot;&gt;1&lt;/span&gt;]*t)+(&lt;span style=&quot;color: #098658;&quot;&gt;1&lt;/span&gt;-p[&lt;span style=&quot;color: #098658;&quot;&gt;3&lt;/span&gt;])*exp(-p[&lt;span style=&quot;color: #098658;&quot;&gt;2&lt;/span&gt;]*t))&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;color: #008000;&quot;&gt;# Gradients&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;color: #008000;&quot;&gt;# For each of the models defined above, specify the gradient&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;color: #0000ff;&quot;&gt;def&lt;/span&gt; model_exp_grad(p,t):&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;    e1 = exp(-p[&lt;span style=&quot;color: #098658;&quot;&gt;1&lt;/span&gt;]*t)&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;    g0 = e1&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;    g1 = -t*p[&lt;span style=&quot;color: #098658;&quot;&gt;0&lt;/span&gt;]*e1&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;    &lt;span style=&quot;color: #0000ff;&quot;&gt;return&lt;/span&gt; asarray([g0,g1], dtype=object)&lt;/div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;fontSize=54;fontColor=#E1812D;fontStyle=1" parent="7Us3IM6Tyc1Voor4KtUj-1" vertex="1">
          <mxGeometry x="20" y="906" width="790" height="894" as="geometry" />
        </mxCell>
        <mxCell id="7Us3IM6Tyc1Voor4KtUj-9" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=54;fontColor=#E1812D;strokeWidth=4;align=left;verticalAlign=bottom;fillColor=none;" parent="7Us3IM6Tyc1Voor4KtUj-1" vertex="1">
          <mxGeometry x="7" y="854" width="816" height="994" as="geometry" />
        </mxCell>
        <mxCell id="7Us3IM6Tyc1Voor4KtUj-10" value="C. dwMRS" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=38;" parent="7Us3IM6Tyc1Voor4KtUj-1" vertex="1">
          <mxGeometry x="20" y="863" width="193" height="39" as="geometry" />
        </mxCell>
        <mxCell id="7Us3IM6Tyc1Voor4KtUj-15" value="A bi-exponential model&amp;nbsp; is defined for the metabolite concentrations, except the macromolecules which are mono-exponential. An exponential (+ offset) model is used for the baseline." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=25;fontStyle=2" parent="7Us3IM6Tyc1Voor4KtUj-1" vertex="1">
          <mxGeometry x="209" y="1018" width="610.5" height="127" as="geometry" />
        </mxCell>
        <mxCell id="7Us3IM6Tyc1Voor4KtUj-16" value="Bounds are used to impose a consistent ordering between fast and slow ADCs, and enforce a fraction between 0 and 1." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=25;fontStyle=2" parent="7Us3IM6Tyc1Voor4KtUj-1" vertex="1">
          <mxGeometry x="209" y="1156" width="573" height="100" as="geometry" />
        </mxCell>
        <mxCell id="7Us3IM6Tyc1Voor4KtUj-17" value="All models (exponential, bi-exponential, exponential + offset) are defined here." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=25;fontStyle=2" parent="7Us3IM6Tyc1Voor4KtUj-1" vertex="1">
          <mxGeometry x="209" y="1376" width="590" height="100" as="geometry" />
        </mxCell>
        <mxCell id="7Us3IM6Tyc1Voor4KtUj-18" value="Analytical expressions are provided for the function gradients Defined with the model function name + &quot;_grad&quot;." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=25;fontStyle=2" parent="7Us3IM6Tyc1Voor4KtUj-1" vertex="1">
          <mxGeometry x="323" y="1686" width="507" height="105" as="geometry" />
        </mxCell>
        <mxCell id="Pzw6lO6rMx2LM9x4CfOI-0" value="Baseline amplitude (b_amp) can be negative unlike concentration. Limit on decay speeds are imposed." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=25;fontStyle=2" parent="7Us3IM6Tyc1Voor4KtUj-1" vertex="1">
          <mxGeometry x="209" y="1261" width="573" height="100" as="geometry" />
        </mxCell>
        <mxCell id="Pzw6lO6rMx2LM9x4CfOI-1" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;Bi-exponential and exponential+offset gradient not shown.&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=25;fontStyle=2" parent="7Us3IM6Tyc1Voor4KtUj-1" vertex="1">
          <mxGeometry x="24" y="1792" width="507" height="69" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
